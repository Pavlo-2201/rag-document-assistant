# LF keeps vendored file hashes and experiment fingerprints portable.
* text=auto eol=lf
# CSV uses RFC-style CRLF; preserve bytes, including verbatim source paragraphs.
*.csv -text whitespace=cr-at-eol
# Keep recorded hashes of experiment inputs and raw outputs byte-identical.
*.jsonl -text whitespace=cr-at-eol
*.json -text whitespace=cr-at-eol
*.yaml -text whitespace=cr-at-eol
